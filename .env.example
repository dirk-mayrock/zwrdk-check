# ZWRD-K Login-Zugangsdaten
ZWRD_EMAIL=deine@email.de
ZWRD_PASSWORD=deinPasswort

# E-Mail-Empfänger für Benachrichtigungen
MAIL_TO=benachrichtigung@email.de

# Absender (muss in Resend als verifizierte Domain eingetragen sein)
# Für Tests kann auch onboarding@resend.dev genutzt werden (nur an deine Resend-Account-Mail)
MAIL_FROM=wachplan@deine-domain.de

# Resend API Key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Optional: Trockenlauf ohne E-Mail-Versand (true/false)
DRY_RUN=false
